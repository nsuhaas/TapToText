#!/bin/zsh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
LOG_DIR="$HOME/.taptotext"

mkdir -p "$LOG_DIR"
cd "$PROJECT_DIR" || exit 1
export PATH="$PROJECT_DIR/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/opt/anaconda3/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
if /usr/bin/arch -arm64 "$PROJECT_DIR/.venv/bin/python" -c "import platform; raise SystemExit(0 if platform.machine() == 'arm64' else 1)" >/dev/null 2>&1; then
  exec /usr/bin/arch -arm64 "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/taptotext_widget.py" >> "$LOG_DIR/widget.log" 2>&1
fi

exec "$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/taptotext_widget.py" >> "$LOG_DIR/widget.log" 2>&1
